{
    "key": "harbour",
    "name": "Harbour",
    "about": "Sea-glass blues on a misty page, a calm literary serif, and a wave under the masthead.",
    "version": "1.0",
    "author": "Booklet",
    "needs": "1.0",
    "preview": "preview.png",
    "css": ["harbour.css"],
    "fonts": {
        "literata": { "name": "Literata", "google": "Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400", "stack": "'Literata', Georgia, serif", "use": ["titles"] },
        "manrope": { "name": "Manrope", "google": "Manrope:wght@400;500;600", "stack": "'Manrope', system-ui, sans-serif", "use": ["labels"] }
    },
    "papers": {
        "mist": { "name": "Sea mist", "paper": "#F3F7F7", "paper_2": "#E6EEEF", "rule": "#D6E2E4", "rule_2": "#BFD0D3", "ink": "#16232A" },
        "sand": { "name": "Wet sand", "paper": "#F8F4EC", "paper_2": "#EEE7DA", "rule": "#E2D9C8", "rule_2": "#CEC2AC", "ink": "#1F1D18" }
    },
    "options": {
        "waves": { "type": "toggle", "label": "A wave under the masthead", "default": true, "class": "harbour-waves" },
        "pictures": { "type": "select", "label": "Picture corners", "options": { "rounded": "Rounded", "porthole": "Round, like a porthole" }, "default": "rounded", "class": "harbour-pictures-{value}", "hint": "Round suits square pictures best." },
        "link": { "type": "color", "label": "Link colour", "default": "#1F6F8B", "variable": "harbour-link" }
    },
    "presets": {
        "high-tide": { "name": "High tide", "about": "Mist, deep sea blue, the menu centred.", "title_font": "literata", "label_font": "manrope", "accent": "#2B7A99", "paper": "mist", "header": "centered", "home": "feature", "corners": "soft", "tilt": false },
        "low-tide": { "name": "Low tide", "about": "Wet sand and coral, posts as a list.", "title_font": "literata", "label_font": "manrope", "accent": "#E07A5F", "paper": "sand", "header": "classic", "home": "list", "corners": "soft", "tilt": true, "options": { "waves": false, "link": "#B4533B" } }
    }
}
