# Booklet uploaded into the main folder of a shared host (public_html, say):
# everything is answered from public/, so Booklet's own files (.env, storage,
# vendor, the database) can never be fetched. Where you can, point the
# domain at the public folder instead; then this file isn't used.
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite, at least nothing starting with a dot (.env) is handed out.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
